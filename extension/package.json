{
  "name": "folio-markdown-editor",
  "displayName": "Folio Markdown Editor",
  "description": "Opt-in editors for Markdown, plain text, Word documents and spreadsheets, plus a read-only PDF viewer.",
  "version": "0.1.0",
  "publisher": "smithja06",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": { "color": "#1d5a40", "theme": "dark" },
  "repository": {
    "type": "git",
    "url": "https://github.com/smithja06/universal-markdown-editor-extension.git",
    "directory": "extension"
  },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other"],
  "main": "./dist/extension.cjs",
  "extensionKind": ["workspace"],
  "capabilities": { "virtualWorkspaces": true, "untrustedWorkspaces": { "supported": false } },
  "files": ["media/icon.png", "dist/extension.cjs", "dist/docx-codec.cjs", "dist/spreadsheet-codec.cjs", "dist/spreadsheet.wasm", "dist/DOCX_THIRD_PARTY_NOTICES.txt", "dist/PDF_THIRD_PARTY_NOTICES.txt", "dist/SPREADSHEET_THIRD_PARTY_NOTICES.txt", "dist/webview", "CHANGELOG.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "EPL-1.0.txt", "EPL-2.0.txt"],
  "contributes": {
    "commands": [
      { "command": "folio.openWith", "title": "Open with Folio", "category": "Folio" },
      { "command": "folio.showVisual", "title": "Show Visual Editor", "category": "Folio", "enablement": "activeCustomEditorId == folio.markdown" },
      { "command": "folio.showMarkdown", "title": "Show Markdown Source", "category": "Folio", "enablement": "activeCustomEditorId == folio.markdown" },
      { "command": "folio.showSplit", "title": "Show Split Editor", "category": "Folio", "enablement": "activeCustomEditorId == folio.markdown" },
      { "command": "folio.toggleProperties", "title": "Toggle Document Properties", "category": "Folio", "enablement": "activeCustomEditorId == folio.markdown" },
      { "command": "folio.goToHeading", "title": "Go to Heading", "category": "Folio", "enablement": "activeCustomEditorId == folio.markdown" },
      { "command": "folio.showCommands", "title": "Show Folio Commands", "category": "Folio", "enablement": "activeCustomEditorId == folio.markdown" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "folio.openWith", "when": "resourceExtname =~ /^\\.(md|markdown|txt|docx|pdf|xlsx|csv)$/i" },
        { "command": "folio.showVisual", "when": "activeCustomEditorId == folio.markdown" },
        { "command": "folio.showMarkdown", "when": "activeCustomEditorId == folio.markdown" },
        { "command": "folio.showSplit", "when": "activeCustomEditorId == folio.markdown" },
        { "command": "folio.toggleProperties", "when": "activeCustomEditorId == folio.markdown" },
        { "command": "folio.goToHeading", "when": "activeCustomEditorId == folio.markdown" },
        { "command": "folio.showCommands", "when": "activeCustomEditorId == folio.markdown" }
      ],
      "explorer/context": [
        { "command": "folio.openWith", "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.(md|markdown|txt|docx|pdf|xlsx|csv)$/i", "group": "navigation@19" }
      ],
      "editor/title/context": [
        { "command": "folio.openWith", "when": "resourceExtname =~ /^\\.(md|markdown|txt|docx|pdf|xlsx|csv)$/i", "group": "1_open@1" }
      ],
      "editor/title": [
        { "submenu": "folio.editorActions", "when": "activeCustomEditorId == folio.markdown", "group": "1_view" }
      ],
      "folio.editorActions": [
        { "command": "folio.showVisual", "group": "1_mode@1" },
        { "command": "folio.showMarkdown", "group": "1_mode@2" },
        { "command": "folio.showSplit", "group": "1_mode@3" },
        { "command": "folio.toggleProperties", "group": "2_document@1" },
        { "command": "folio.goToHeading", "group": "2_document@2" },
        { "command": "folio.showCommands", "group": "2_document@3" }
      ]
    },
    "submenus": [{ "id": "folio.editorActions", "label": "Folio" }],
    "keybindings": [
      { "command": "folio.showVisual", "key": "ctrl+alt+shift+v", "mac": "cmd+alt+shift+v", "when": "activeCustomEditorId == folio.markdown && !inputFocus" },
      { "command": "folio.showMarkdown", "key": "ctrl+alt+shift+m", "mac": "cmd+alt+shift+m", "when": "activeCustomEditorId == folio.markdown && !inputFocus" },
      { "command": "folio.showSplit", "key": "ctrl+alt+shift+s", "mac": "cmd+alt+shift+s", "when": "activeCustomEditorId == folio.markdown && !inputFocus" }
    ],
    "customEditors": [
      {
        "viewType": "folio.markdown",
        "displayName": "Folio Markdown Editor",
        "selector": [{ "filenamePattern": "*.md" }, { "filenamePattern": "*.markdown" }],
        "priority": "option"
      },
      {
        "viewType": "folio.txt",
        "displayName": "Folio Plain Text Editor",
        "selector": [{ "filenamePattern": "*.txt" }],
        "priority": "option"
      },
      {
        "viewType": "folio.docx",
        "displayName": "Folio DOCX Editor",
        "selector": [{ "filenamePattern": "*.docx" }],
        "priority": "option"
      },
      {
        "viewType": "folio.pdf",
        "displayName": "Folio PDF Viewer",
        "selector": [{ "filenamePattern": "*.pdf" }],
        "priority": "option"
      },
      {
        "viewType": "folio.xlsx",
        "displayName": "Folio XLSX Editor",
        "selector": [{ "filenamePattern": "*.xlsx" }],
        "priority": "option"
      },
      {
        "viewType": "folio.csv",
        "displayName": "Folio CSV Editor",
        "selector": [{ "filenamePattern": "*.csv" }],
        "priority": "option"
      }
    ]
  }
}
