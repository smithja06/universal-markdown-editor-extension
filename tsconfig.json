{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "isolatedModules": true
  },
  "include": ["src", "tests", "scripts", "vite.config.ts", "vite.webview.config.ts", "playwright.config.ts", "playwright.vscode.config.ts"]
}
